    $identityEvidenceHash=Get-RapIdentityEvidenceHash $IdentityResolution;$lookupEvidenceHash=Get-RapLookupEvidenceHash $Store $IdentityResolution
    $decisionId=if($Store.Decisions.ContainsKey($Promotion.CandidateId)){[string]$Store.Decisions[$Promotion.CandidateId].DecisionId}else{'DEC-'+[guid]::NewGuid().ToString('N')}
    $revalidationEvidenceHash=Get-RapIntakeHash ([ordered]@{DecisionId=$decisionId;ProjectId=$persistedPromotion.ProjectId;ResearchQuestionId=$persistedPromotion.ResearchQuestionId;SearchExecutionId=$persistedPromotion.SearchExecutionId;CandidateId=$persistedPromotion.CandidateId;PromotionHash=$persistedPromotion.PromotionHash;CandidateIdentityHash=$persistedPromotion.CandidateIdentityHash;IdentityEvidenceHash=$identityEvidenceHash;LookupExecutionId=$snapshot.ExecutionId;LookupEvidenceHash=$lookupEvidenceHash;Result='PASS'})
    $revalidation=Add-RapIntakeAudit $Store 'PROMOTION_LINEAGE_REVALIDATED' 'LINEAGE_REVALIDATED' @{DecisionId=$decisionId;ProjectId=$persistedPromotion.ProjectId;ResearchQuestionId=$persistedPromotion.ResearchQuestionId;SearchExecutionId=$persistedPromotion.SearchExecutionId;CandidateId=$persistedPromotion.CandidateId;PromotionHash=$persistedPromotion.PromotionHash;CurrentLineageHash=$persistedPromotion.PromotionHash;CandidateIdentityHash=$persistedPromotion.CandidateIdentityHash;IdentityEvidenceHash=$identityEvidenceHash;LookupExecutionId=$snapshot.ExecutionId;LookupEvidenceHash=$lookupEvidenceHash;Result='PASS';EvidenceHash=$revalidationEvidenceHash}
