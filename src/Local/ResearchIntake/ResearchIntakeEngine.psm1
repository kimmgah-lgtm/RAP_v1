    $decision=[pscustomobject]@{PSTypeName='Rap.ZoteroDecision';BindingVersion=2;DecisionId=$decisionId;ProjectId=$Promotion.ProjectId;ResearchQuestionId=$Promotion.ResearchQuestionId;SearchExecutionId=$Promotion.SearchExecutionId;CandidateId=$Promotion.CandidateId;PromotionHash=$Promotion.PromotionHash;CandidateIdentityHash=$persistedPromotion.CandidateIdentityHash;IdentityBindingHash=$IdentityResolution.IdentityBindingHash;IdentityEvidenceHash=$identityEvidenceHash;Decision=$decisionName;Reason=$reason;CanonicalKey=$IdentityResolution.CanonicalKey;CanonicalTargetIdentity=$canonicalTarget;CanonicalStatus=$canonicalStatus;ZoteroStatus=$zoteroStatus;LookupExecutionId=$snapshot.ExecutionId;LookupExecutedAt=$snapshot.ExecutedAt;LookupEvidenceHash=$lookupEvidenceHash;CanonicalMatches=$canonicalMatches.Count;ZoteroMatches=$zoteroMatches.Count;ZoteroItemId=$zoteroId;ZoteroLibraryContext=$libraryContext;ExactTargetEvidenceHash=$targetHash;State=$decisionName;RevalidationSequence=$revalidation.Sequence;RevalidationEvidenceHash=$revalidationEvidenceHash;DecidedAt=[DateTimeOffset]::UtcNow.ToString('o');DecisionBindingHash='';DecisionAuditSequence=0;ProductionWrite='DISABLED';ChangesApplied=$false}
    $decision.DecisionBindingHash=Get-RapIntakeHash (Get-RapDecisionBinding $decision)
