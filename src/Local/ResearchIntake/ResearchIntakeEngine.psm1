        if($valid){$valid=(Get-RapIntakeHash (Get-RapDecisionBinding $existing))-ceq$existing.DecisionBindingHash-and$existing.ProjectId-ceq$Promotion.ProjectId-and$existing.ResearchQuestionId-ceq$Promotion.ResearchQuestionId-and$existing.SearchExecutionId-ceq$Promotion.SearchExecutionId-and$existing.CandidateId-ceq$Promotion.CandidateId-and$existing.PromotionHash-ceq$Promotion.PromotionHash-and$existing.CandidateIdentityHash-ceq$persistedPromotion.CandidateIdentityHash-and$existing.IdentityBindingHash-ceq$IdentityResolution.IdentityBindingHash-and$existing.IdentityEvidenceHash-ceq$identityEvidenceHash-and$existing.LookupExecutionId-ceq$snapshot.ExecutionId-and$existing.LookupEvidenceHash-ceq$lookupEvidenceHash-and(Test-RapDecisionAuditProof $Store $existing)}
        if($valid){return $existing};[void](Add-RapIntakeAudit $Store 'DECISION_REUSE_BLOCKED' 'BLOCKED' @{DecisionId=$decisionId;CandidateId=$Promotion.CandidateId;Reason='STALE_OR_INVALID_DECISION_EVIDENCE';CurrentLookupEvidenceHash=$lookupEvidenceHash});return New-RapBlockedReplayDecision $Promotion $IdentityResolution 'STALE_OR_INVALID_DECISION_EVIDENCE'
