    $decision.DecisionAuditSequence=$decisionAudit.Sequence;if($decisionName-ceq'CREATE_CANDIDATE'){$Store.Counters.ZoteroCreateDecision++};$Store.Decisions[$Promotion.CandidateId]=$decision;$Store.Lifecycles[$Promotion.CandidateId]=$decision.State;if($Store.DatabasePath){[void](Save-RapResearchIntakeStore $Store)};$decision
}

function Invoke-RapResearchIntakeDecision {
    [CmdletBinding()]param([Parameter(Mandatory)]$Store,[Parameter(Mandatory)]$Promotion)
    if($Store.ProductionWrite-cne'DISABLED'-or$Store.ProductionPilot-cne'TEST_DEFERRED'){throw 'UNSAFE_RESEARCH_INTAKE_MODE'}
    $identity=Resolve-RapCanonicalPaperIdentity $Store $Promotion;$decision=Get-RapPreZoteroDedupDecision $Store $Promotion $identity
    [pscustomobject]@{Identity=$identity;Decision=$decision;ProductionWrite='DISABLED';ProductionPilot='TEST_DEFERRED';ProductionMutations=[pscustomobject]@{Zotero=$Store.Counters.ZoteroMutation;Drive=$Store.Counters.DriveMutation;Notion=$Store.Counters.NotionMutation};LibraryIdAllocations=$Store.Counters.LibraryIdAllocation;PaperReviewsCreated=$Store.Counters.PaperReviewCreation}
}
function Get-RapResearchIntakeAudit { [CmdletBinding()]param([Parameter(Mandatory)]$Store) @($Store.Audit|ForEach-Object{Copy-RapIntakeValue $_}) }
function Get-RapResearchIntakeRecoveryStatus {[CmdletBinding()]param([Parameter(Mandatory)]$Store,[Parameter(Mandatory)][string]$CandidateId)if(-not$Store.Lifecycles.ContainsKey($CandidateId)){throw 'UNKNOWN_INBOX_CANDIDATE'};$s=[string]$Store.Lifecycles[$CandidateId];[pscustomobject]@{CandidateId=$CandidateId;PersistedState=$s;Status=$(if($s-in@('IDENTITY_RESOLVING','DEDUP_CHECKED')){'RECOVERY_REQUIRED'}elseif($s-in@('CREATE_CANDIDATE','REUSE_EXISTING','AMBIGUOUS','IDENTITY_CONFLICT','BLOCKED')){'ALREADY_COMPLETED'}else{'RESUMABLE'});AutomaticAdvance=$false;ProductionWrite='DISABLED'} }
function Invoke-RapResearchIntakeReadOnlyLookup {[CmdletBinding()]param([Parameter(Mandatory)]$Store,[Parameter(Mandatory)][ValidateSet('PASS','TIMEOUT','NETWORK_FAILURE','MALFORMED','AUTH_FAILURE','PERMISSION_AMBIGUITY','PARTIAL','UNKNOWN','MULTIPLE')][string]$Outcome,[object[]]$CanonicalResults=@(),[object[]]$ZoteroResults=@())
    if($Store.ProductionWrite-cne'DISABLED'){throw 'UNSAFE_RESEARCH_INTAKE_MODE'};$executionId='LOOKUP-'+[guid]::NewGuid().ToString('N')
    $reason=$Outcome;if($Outcome-ceq'PASS'){foreach($x in @($CanonicalResults+$ZoteroResults)){if(-not$x.PSObject.Properties['CanonicalKey']-or[string]::IsNullOrWhiteSpace([string]$x.CanonicalKey)){$Outcome='MALFORMED';$reason='MALFORMED';break}}}
    if($Outcome-ceq'PASS'){$Store.CanonicalPapers=@($CanonicalResults|ForEach-Object{Copy-RapIntakeValue $_});$Store.ZoteroItems=@($ZoteroResults|ForEach-Object{Copy-RapIntakeValue $_});$Store.LookupSnapshot=New-RapLookupSnapshot 'PASS' 'READ_ONLY_FIXTURE' $CanonicalResults $ZoteroResults $executionId}
    else{$Store.LookupSnapshot=New-RapLookupSnapshot 'LOOKUP_FAILED' $reason @() @() $executionId}
    [void](Add-RapIntakeAudit $Store 'READ_ONLY_LOOKUP_EXECUTED' $(if($Outcome-ceq'PASS'){'LOOKUP_COMPLETE'}else{'LOOKUP_FAILED'}) @{ExecutionId=$executionId;Outcome=$Outcome;Reason=$Store.LookupSnapshot.Reason;CanonicalStatus=$Store.LookupSnapshot.CanonicalStatus;ZoteroStatus=$Store.LookupSnapshot.ZoteroStatus;CanonicalCount=$Store.LookupSnapshot.CanonicalCount;ZoteroCount=$Store.LookupSnapshot.ZoteroCount})
    [pscustomobject]@{Status=$Store.LookupSnapshot.Status;Reason=$Store.LookupSnapshot.Reason;CanonicalStatus=$(if($Outcome-ceq'PASS'){if($CanonicalResults.Count-eq0){'NOT_FOUND'}elseif($CanonicalResults.Count-eq1){'FOUND'}else{'MULTIPLE'}}else{'UNKNOWN'});ZoteroStatus=$(if($Outcome-ceq'PASS'){if($ZoteroResults.Count-eq0){'NOT_FOUND'}elseif($ZoteroResults.Count-eq1){'FOUND'}else{'MULTIPLE'}}else{'UNKNOWN'});ExecutionId=$executionId;ChangesApplied=$false;ProductionWrite='DISABLED'}
}

